# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/class-hub

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Cloudinary server-side uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email verification
RESEND_API_KEY=
RESEND_FROM_EMAIL=Class Hub <noreply@example.com>
